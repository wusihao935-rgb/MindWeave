# Backend only. Put these on Render/Railway/server, never in the frontend host.
PORT=4141
CORS_ORIGIN=https://your-mindweave-web.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=mindweave-documents
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Set to true only for isolated local fallback testing without Supabase.
ALLOW_LOCAL_FALLBACK=false

# Frontend only. Put these on Vercel/Netlify/Cloudflare Pages.
VITE_API_BASE_URL=https://your-mindweave-api.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
